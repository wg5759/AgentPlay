{
  "name": "ai-player",
  "version": "0.9.1",
  "author": "AgentPlay",
  "description": "AI媒体中枢 - 会动手的播放器（桌面+Web双端）",
  "main": "electron/main.js",
  "scripts": {
    "dev:web": "vite",
    "dev:electron": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "build:web": "node scripts/build-web.mjs",
    "build:electron": "pnpm build:electron:lean",
    "build:electron:lean": "pnpm build:web && node scripts/build-voice-helper.mjs && electron-builder --config electron-builder.lean.yml",
    "build:electron:local-ai": "pnpm build:web && node scripts/build-voice-helper.mjs && electron-builder",
    "preview": "vite preview",
    "platform:report": "node scripts/platform-capability-report.mjs",
    "release:verify": "node scripts/verify-release.mjs",
    "release:portable": "node scripts/prepare-portable-archive.mjs --replace",
    "release:assets": "node scripts/prepare-release-assets.mjs --channel preview --ack-unsigned",
    "release:assets:preview": "node scripts/prepare-release-assets.mjs --channel preview --ack-unsigned",
    "release:assets:beta": "node scripts/prepare-release-assets.mjs --channel beta --ack-unsigned",
    "release:assets:stable": "node scripts/prepare-release-assets.mjs --channel stable",
    "release:public:verify": "node scripts/verify-public-release-readiness.mjs",
    "release:public:verify:binary": "node scripts/verify-public-release-readiness.mjs --binary",
    "security:scan": "node scripts/security-release-scan.mjs --history",
    "security:scan:packaged": "node scripts/security-release-scan.mjs --history --packaged",
    "test": "node scripts/run-tests.mjs",
    "check": "pnpm exec tsc --noEmit && pnpm exec eslint src --max-warnings=0 && pnpm security:scan && pnpm release:public:verify && pnpm test && pnpm build:web"
  },
  "dependencies": {
    "@gutenye/ocr-node": "^1.4.8",
    "@huggingface/transformers": "^4.2.0",
    "docx": "9.7.1",
    "electron-log": "^5.4.4",
    "exceljs": "4.4.0",
    "formidable": "^3.5.4",
    "jszip": "3.10.1",
    "mammoth": "^1.12.0",
    "pdf-lib": "1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "unpdf": "^1.8.0",
    "word-extractor": "^1.0.4",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.4",
    "concurrently": "^9.1.0",
    "electron": "43.3.0",
    "electron-builder": "26.15.7",
    "7zip-bin": "5.2.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "6.4.3",
    "vite-plugin-pwa": "^0.21.1",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.aiplayer.app",
    "productName": "AgentPlay",
    "asar": true,
    "compression": "normal",
    "npmRebuild": false,
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/bin/win",
        "to": "bin/win",
        "filter": [
          "mpv.exe",
          "mpv.com",
          "vulkan-1.dll",
          "ai-player-voice.exe"
        ]
      },
      {
        "from": "resources/ai-runtime/win-x64",
        "to": "ai-runtime/win-x64",
        "filter": [
          "llama-server.exe",
          "*.dll"
        ]
      },
      {
        "from": "resources/models/Qwen2.5-0.5B-Instruct-Q4_0.gguf",
        "to": "models/Qwen2.5-0.5B-Instruct-Q4_0.gguf"
      },
      {
        "from": "resources/bundled-ai-manifest.json",
        "to": "bundled-ai-manifest.json"
      },
      {
        "from": "resources/licenses",
        "to": "licenses",
        "filter": [
          "llama.cpp/**/*",
          "mpv/**/*",
          "qwen2.5-0.5b/LICENSE",
          "qwen2.5-0.5b/README.md"
        ]
      },
      {
        "from": "LICENSE",
        "to": "legal/LICENSE"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "legal/THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "PRIVACY.md",
        "to": "legal/PRIVACY.md"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/icons/app-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "installerIcon": "resources/icons/app-icon.ico",
      "uninstallerIcon": "resources/icons/app-icon.ico",
      "artifactName": "AgentPlay-本地AI版安装包-${version}.${ext}"
    }
  },
  "pnpm": {
    "patchedDependencies": {
      "builder-util@26.15.3": "patches/builder-util@26.15.3.patch"
    },
    "overrides": {
      "browserslist": "4.28.7",
      "exceljs>uuid": "11.1.1",
      "onnxruntime-node": "1.24.3",
      "adm-zip": ">=0.6.0",
      "sharp": ">=0.35.0",
      "minimatch@3>brace-expansion": "2.1.4",
      "onnxruntime-web": "1.24.3",
      "fast-uri": "3.1.5",
      "js-yaml": "4.3.1",
      "postcss>nanoid": "3.3.18",
      "tar": "7.5.21",
      "xcode>uuid": "11.1.1"
    },
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "sharp"
    ]
  }
}
